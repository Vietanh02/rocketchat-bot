# --- Portal / app ---
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_LOG_LEVEL=INFO

# First admin created on startup if no portal user exists yet
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_PASSWORD=changeme123

# --- Rocket.Chat (can also be set later from the portal) ---
APP_RC_REST_URL=http://localhost:3000
APP_RC_WS_URL=ws://localhost:3000/websocket
# Personal Access Token from Rocket.Chat > My Account > Personal Access Tokens
APP_RC_BOT_USER_ID=
APP_RC_BOT_AUTH_TOKEN=
# Fallback: username/password login (used only when no token is set)
APP_RC_BOT_USERNAME=
APP_RC_BOT_PASSWORD=

# --- Integration safety ---
# Allow integrations to call private/loopback addresses (dev only)
APP_ALLOW_PRIVATE_INTEGRATION_HOSTS=false

# Script commands (Response type "Run a script" in the portal).
# Defaults to the scripts/ folder at the repository root.
# APP_SCRIPTS_DIR=/path/to/scripts
# Environment variables scripts may read, comma-separated. Nothing else is passed.
# APP_SCRIPT_ENV_PASSTHROUGH=WEATHER_API_KEY
# Scripts allowed to run at the same time.
# APP_SCRIPT_MAX_CONCURRENCY=20

# --- Language model ---
# Configured on the portal's Language model page. These only seed it when the
# database is first created; after that the portal's values are used.
# APP_LLM_BASE_URL=https://localcal.ai/aigw/ai/v1
# APP_LLM_API_KEY=sk-...
# APP_LLM_MODEL=glm-4.6
# "{bot}" is replaced with the bot's username. Empty uses a built-in prompt.
# APP_LLM_SYSTEM_PROMPT=
# APP_LLM_TIMEOUT_SECONDS=60
# APP_LLM_MAX_TOKENS=
# APP_LLM_TEMPERATURE=
# Earlier messages of the conversation sent with each question (0 = none).
# APP_LLM_HISTORY_MESSAGES=10
# Rounds of tool calls in one answer (1-100). Past them the model answers
# from what it has, without more tools.
# APP_MAX_TOOL_ROUNDS=20

# --- Vector database (assistant memory) ---
# Qdrant's REST address. docker compose sets it to the bundled Qdrant; leave it
# unset to find notes by their words only. The embedding model is chosen on the
# portal's Memory page.
# APP_QDRANT_URL=http://localhost:6333
# APP_QDRANT_API_KEY=
# APP_QDRANT_COLLECTION_PREFIX=rcbot_

# Messages the bot handles at the same time (each from a different user or room).
# APP_BOT_MAX_CONCURRENCY=20
