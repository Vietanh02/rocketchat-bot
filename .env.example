# Settings for the whole docker compose stack. Copy to .env next to
# docker-compose.yml; the bot's own settings stay in backend/.env.

# --- Outgoing proxy -------------------------------------------------------
# Used by the backend (LLM gateway, MCP, integrations, Rocket.Chat if it is
# outside) and by embed (model download), and while building the images.
# HTTP_PROXY=http://proxy.example.com:3128
# HTTPS_PROXY=http://proxy.example.com:3128   # defaults to HTTP_PROXY
# With a login: http://user:password@proxy.example.com:3128
#
# Hosts reached directly, comma-separated, added to the containers' own
# names (backend, qdrant, embed, rocketchat, host.docker.internal...).
# Put a Rocket.Chat or gateway on the LAN here. ".example.com" covers its
# subdomains; IP ranges (10.0.0.0/8) are not understood by every client.
# NO_PROXY=chat.example.com,.corp.example.com,10.1.2.3

# --- Certificates -----------------------------------------------------------
# false: HTTPS and WSS certificates are not checked (also pip/npm when
# building). Only for a proxy that re-signs traffic with its own certificate.
# APP_TLS_VERIFY=false

# --- Troubleshooting --------------------------------------------------------
# true: DEBUG logs, a traceback with every warning and error, the cause of a
# failed call in the chat reply, and tracebacks in portal API errors.
# Also for one run:  APP_DEBUG=true docker compose up -d backend
# APP_DEBUG=false

# --- Others -----------------------------------------------------------------
# PORTAL_PORT=8081
# BOT_VERSION=latest
